{
  "name": "agenttrust-xrpl-escrow",
  "version": "2",
  "chain_type": "xrpl",
  "rules": [
    {
      "action": "ALLOW",
      "method": "xrpl_signTransaction",
      "conditions": [{"field_source": "xrpl_transaction", "field": "TransactionType", "operator": "eq", "value": "EscrowCreate"}]
    },
    {
      "action": "ALLOW",
      "method": "xrpl_signTransaction",
      "conditions": [{"field_source": "xrpl_transaction", "field": "TransactionType", "operator": "eq", "value": "EscrowCancel"}]
    },
    {
      "action": "ALLOW",
      "method": "xrpl_signTransaction",
      "conditions": [{"field_source": "xrpl_transaction", "field": "TransactionType", "operator": "eq", "value": "EscrowFinish"}]
    },
    {
      "action": "ALLOW",
      "method": "xrpl_signTransaction",
      "conditions": [{"field_source": "xrpl_transaction", "field": "TransactionType", "operator": "eq", "value": "AccountSet"}]
    },
    {
      "action": "ALLOW",
      "method": "xrpl_signTransaction",
      "conditions": [
        {"field_source": "xrpl_transaction", "field": "TransactionType", "operator": "eq", "value": "Payment"},
        {"field_source": "xrpl_transaction", "field": "Amount.drops", "operator": "lt", "value": "100000000000"}
      ]
    },
    {"action": "DENY", "method": "xrpl_signTransaction"}
  ]
}
